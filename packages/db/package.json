{
  "name": "@lumino/db",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "migrate:up": "node-pg-migrate --migrations-dir dist/migrations --ignore-pattern \".*\\.d\\.ts\" up",
    "migrate:down": "node-pg-migrate --migrations-dir dist/migrations --ignore-pattern \".*\\.d\\.ts\" down"
  },
  "dependencies": {
    "node-pg-migrate": "^6.2.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "typescript": "^5.3.3"
  }
}
